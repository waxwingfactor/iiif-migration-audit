{
  "name": "iiif-migration-audit",
  "version": "1.0.0",
  "description": "Independent preservation checks for IIIF manifest migrations",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/waxwingfactor/iiif-migration-audit.git"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "vite --host 127.0.0.1",
    "build": "npm run build:cli && npm run build:web",
    "build:cli": "node scripts/build-cli.mjs",
    "build:web": "vite build && node scripts/postbuild-web.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "cli": "tsx src/cli/index.ts",
    "test:browser": "playwright test --config tests/browser/playwright.config.ts",
    "prepack": "npm run build:cli",
    "test:package": "node scripts/smoke-package.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "jsonc-parser": "^3.3.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "bin": {
    "iiif-audit": "dist/cli/index.js"
  },
  "files": [
    "dist/cli",
    "docs/cli.md",
    "docs/core-api.md",
    "docs/user-guide.md",
    "examples",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md"
  ]
}
